        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    users ||--o{ places : \&quot;владеет (owner_id)\&quot;\n    users ||--o{ checkins : \&quot;совершает (user_id)\&quot;\n    users ||--o{ reviews : \&quot;оставляет (user_id)\&quot;\n    users ||--o{ user_achievements : \&quot;получает (user_id)\&quot;\n    places ||--o{ checkins : \&quot;имеет посещения (place_id)\&quot;\n    places ||--o{ reviews : \&quot;имеет отзывы (place_id)\&quot;\n    checkins ||--o| reviews : \&quot;подтверждает (checkin_id)\&quot;\n    achievements ||--o{ user_achievements : \&quot;присваивается (achievement_id)\&quot;\n\n    users {\n        int id PK\n        varchar username UK \&quot;Логин\&quot;\n        varchar email UK \&quot;Почта\&quot;\n        varchar password_hash \&quot;Хэш пароля\&quot;\n        varchar role \&quot;visitor | owner | admin\&quot;\n        int total_points \&quot;Очки рейтинга (default 0)\&quot;\n        timestamp created_at\n    }\n\n    places {\n        int id PK\n        int owner_id FK \&quot;Владелец заведения (users.id)\&quot;\n        varchar name \&quot;Название заведения\&quot;\n        varchar street \&quot;Улица\&quot;\n        varchar address \&quot;Полный адрес\&quot;\n        text description \&quot;Описание\&quot;\n        geometry_point location \&quot;Координаты PostGIS (lon, lat)\&quot;\n        varchar secret_key UK \&quot;Индивидуальный ключ (QR-код)\&quot;\n        numeric average_rating \&quot;Средний рейтинг (0.0 - 5.0)\&quot;\n    }\n\n    checkins {\n        int id PK\n        int user_id FK \&quot;Посетитель (users.id)\&quot;\n        int place_id FK \&quot;Заведение (places.id)\&quot;\n        date checkin_date \&quot;Дата визита (для лимита 1 раз в сутки)\&quot;\n        timestamp created_at \&quot;Точное время отметки\&quot;\n    }\n\n    reviews {\n        int id PK\n        int user_id FK \&quot;Автор отзыва (users.id)\&quot;\n        int place_id FK \&quot;Заведение (places.id)\&quot;\n        int checkin_id FK, UK \&quot;Ссылка на визит (checkins.id)\&quot;\n        int rating \&quot;Оценка от 1 до 5\&quot;\n        text comment \&quot;Текст отзыва\&quot;\n        timestamp created_at\n    }\n\n    achievements {\n        int id PK\n        varchar code UK \&quot;Код условия (напр. first_visit)\&quot;\n        varchar title \&quot;Название достижения\&quot;\n        text description \&quot;Описание условия\&quot;\n        int points \&quot;Очки за достижение (&gt; 0)\&quot;\n    }\n\n    user_achievements {\n        int user_id PK, FK \&quot;Пользователь (users.id)\&quot;\n        int achievement_id PK, FK \&quot;Достижение (achievements.id)\&quot;\n        timestamp awarded_at \&quot;Дата и время получения\&quot;\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="29yLf1Rup1E11E9MXvr_-1">
